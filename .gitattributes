# Normalize line endings for a Windows-first project without breaking POSIX checkouts.
* text=auto eol=lf
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.zip binary
*.whl binary

# Generated evidence bundles should never be committed
*.sqlite binary
*.sqlite-wal binary
*.sqlite-shm binary

# Exclude documentation and tests from language statistics.
src/** linguist-detectable=true
tests/** linguist-documentation=true
docs/** linguist-documentation=true
