# Reference values only. The CLI and broker do not load this file automatically.
# Set environment variables before starting the client and broker.
# Never commit credentials.
TYPESAFE_API_KEY=

# Optional named-pipe override for a specific local broker.
JEV_DESKTOP_PIPE=

# Set to 1 only when the desktop operator has agreed to live tests.
JEV_DESKTOP_LIVE=

# Optional dotenv file read by the live tests, not by the broker.
JEV_TYPESAFE_ENV_FILE=
