# Copy to .env and fill in locally. Never commit the copy: .gitignore excludes .env*.
#
# TypeSafe API key used for policy decisions. Without it the broker still serves
# desktop_inspect, desktop_act, desktop_stop, and status, and a run with steps fails fast
# with a clear message instead of guessing.
TYPESAFE_API_KEY=

# Point a client at a specific broker instead of the per-user, per-logon-session default.
# Useful when several sessions run side by side, or in tests.
JEV_DESKTOP_PIPE=

# Opt in to the suites that create windows and inject real input. Leave unset unless you
# are on a machine nobody else is using.
JEV_DESKTOP_LIVE=
